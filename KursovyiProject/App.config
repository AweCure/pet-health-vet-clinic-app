<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<connectionStrings>
		<add name="VetClinicDB" 
     connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\VetClinicDB.mdf;Integrated Security=True;Pooling=False;" 
     providerName="System.Data.SqlClient" />
	</connectionStrings>

</configuration>